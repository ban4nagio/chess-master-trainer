import tkinter as tk
from tkinter import ttk
import webbrowser
import chess

from trainer_data import LESSONS, LEVELS, DAILY_LESSONS, OPENING_GUIDE, TACTIC_GUIDE

PIECE_SYMBOLS = {
    'P': '♙', 'N': '♘', 'B': '♗', 'R': '♖', 'Q': '♕', 'K': '♔',
    'p': '♟', 'n': '♞', 'b': '♝', 'r': '♜', 'q': '♛', 'k': '♚'
}


class ChessCoachTrainerApp:
    def __init__(self, root):
        self.root = root
        self.root.title('Chess Master Trainer')
        self.root.geometry('1280x760')
        self.root.configure(bg='#111827')

        self.level = 'beginner'
        self.board = chess.Board()
        self.selected_square = None
        self.user_color = chess.WHITE
        self.board_buttons = {}
        self.lesson_cards = []

        self.build_layout()
        self.set_level(self.level)
        self.reset_game()

    def build_layout(self):
        self.main = tk.Frame(self.root, bg='#111827')
        self.main.pack(fill=tk.BOTH, expand=True, padx=18, pady=18)

        self.left_panel = tk.Frame(self.main, bg='#1f2937', padx=12, pady=12)
        self.left_panel.pack(side=tk.LEFT, fill=tk.Y)

        self.center_panel = tk.Frame(self.main, bg='#111827', padx=12)
        self.center_panel.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        self.right_panel = tk.Frame(self.main, bg='#1f2937', padx=12, pady=12)
        self.right_panel.pack(side=tk.RIGHT, fill=tk.Y)

        self.level_label = tk.Label(self.left_panel, text='Livello', font=('Arial', 16, 'bold'), fg='white', bg='#1f2937')
        self.level_label.pack(anchor='w', pady=(0, 8))

        self.level_combo = ttk.Combobox(self.left_panel, values=['Beginner', 'Intermediate', 'Advanced'], state='readonly')
        self.level_combo.current(0)
        self.level_combo.pack(fill=tk.X, pady=(0, 12))
        self.level_combo.bind('<<ComboboxSelected>>', self.on_level_change)

        self.lesson_title = tk.Label(self.left_panel, text='Lezioni di oggi', font=('Arial', 14, 'bold'), fg='#f9fafb', bg='#1f2937')
        self.lesson_title.pack(anchor='w', pady=(8, 8))

        self.lesson_frame = tk.Frame(self.left_panel, bg='#1f2937')
        self.lesson_frame.pack(fill=tk.BOTH, expand=True)

        self.coach_heading = tk.Label(self.right_panel, text='Coach di scacchi', font=('Arial', 16, 'bold'), fg='white', bg='#1f2937')
        self.coach_heading.pack(anchor='w', pady=(0, 10))

        self.coach_text = tk.Text(self.right_panel, height=18, width=34, wrap=tk.WORD, bg='#0f172a', fg='#f8fafc', bd=0)
        self.coach_text.pack(fill=tk.BOTH, expand=True)
        self.coach_text.config(state=tk.DISABLED)

        self.board_frame = tk.Frame(self.center_panel, bg='#111827')
        self.board_frame.pack(fill=tk.BOTH, expand=True)

        for row in range(8):
            for col in range(8):
                btn = tk.Button(
                    self.board_frame,
                    width=4,
                    height=2,
                    font=('Segoe UI Symbol', 30),
                    bg='#f8fafc',
                    fg='#111827',
                    command=lambda r=row, c=col: self.on_square_click(r, c),
                    borderwidth=1,
                    relief='solid'
                )
                btn.grid(row=row, column=col, sticky='nsew')
                self.board_buttons[(row, col)] = btn

        for i in range(8):
            self.board_frame.grid_columnconfigure(i, weight=1)
            self.board_frame.grid_rowconfigure(i, weight=1)

        self.status_var = tk.StringVar(value='Nuova partita avviata. Fai la prima mossa.')
        self.status_bar = tk.Label(self.center_panel, textvariable=self.status_var, bg='#111827', fg='#dbeafe', font=('Arial', 12), justify=tk.LEFT)
        self.status_bar.pack(anchor='w', pady=(12, 0), fill=tk.X)

        self.bottom_bar = tk.Frame(self.center_panel, bg='#111827')
        self.bottom_bar.pack(fill=tk.X, pady=(12, 0))

        self.new_game_btn = tk.Button(self.bottom_bar, text='Nuova partita', command=self.reset_game, bg='#2563eb', fg='white', font=('Arial', 11, 'bold'), padx=18, pady=8)
        self.new_game_btn.pack(side=tk.LEFT)

        self.help_btn = tk.Button(self.bottom_bar, text='Spiega apertura', command=self.show_opening_help, bg='#10b981', fg='white', font=('Arial', 11, 'bold'), padx=18, pady=8)
        self.help_btn.pack(side=tk.LEFT, padx=(10, 0))

        self.tactic_btn = tk.Button(self.bottom_bar, text='Spiega tattica', command=self.show_tactic_help, bg='#f59e0b', fg='white', font=('Arial', 11, 'bold'), padx=18, pady=8)
        self.tactic_btn.pack(side=tk.LEFT, padx=(10, 0))

    def set_level(self, level_name):
        self.level = level_name.lower()
        for widget in self.lesson_frame.winfo_children():
            widget.destroy()

        lessons = LESSONS[self.level]
        for index, lesson in enumerate(lessons[:2], start=1):
            card = tk.LabelFrame(self.lesson_frame, text=f'Lezione {index}', bg='#111827', fg='#e2e8f0', padx=10, pady=10)
            card.pack(fill=tk.X, pady=6)

            title = tk.Label(card, text=lesson['title'], fg='#f8fafc', bg='#111827', font=('Arial', 11, 'bold'), justify=tk.LEFT)
            title.pack(anchor='w')

            concept = tk.Label(card, text=lesson['concept'], fg='#dbeafe', bg='#111827', justify=tk.LEFT, wraplength=220)
            concept.pack(anchor='w', pady=(4, 8))

            btn = tk.Button(card, text='Apri video YouTube', bg='#ef4444', fg='white', command=lambda url=lesson['youtube']: webbrowser.open(url), font=('Arial', 10, 'bold'))
            btn.pack(anchor='w')

        self.update_coach_message(f"Livello: {LEVELS[self.level]['name']}\n\n{LEVELS[self.level]['description']}\n\nPrincipio guida: sviluppa i pezzi, controlla il centro e trova le minacce del tuo avversario.")

    def on_level_change(self, event):
        selected = self.level_combo.get().lower()
        mapping = {'beginner': 'beginner', 'intermediate': 'intermediate', 'advanced': 'advanced'}
        self.set_level(mapping[selected])
        self.reset_game()

    def update_coach_message(self, message):
        self.coach_text.config(state=tk.NORMAL)
        self.coach_text.delete('1.0', tk.END)
        self.coach_text.insert(tk.END, message)
        self.coach_text.config(state=tk.DISABLED)

    def reset_game(self):
        self.board = chess.Board()
        self.selected_square = None
        self.status_var.set('Nuova partita avviata. Fai la prima mossa.')
        self.update_coach_message(
            f"{LEVELS[self.level]['coach_title']}\n\n"
            f"{OPENING_GUIDE[self.level]}\n\n"
            f"{TACTIC_GUIDE[self.level]}"
        )
        self.refresh_board()

    def on_square_click(self, row, col):
        square = chess.square(col, 7 - row)
        piece = self.board.piece_at(square)

        if self.selected_square is None:
            if piece is not None and piece.color == self.user_color:
                self.selected_square = square
                self.refresh_board()
            return

        move = chess.Move.from_uci(f'{chess.square_name(self.selected_square)}{chess.square_name(square)}')
        if move in self.board.legal_moves:
            self.board.push(move)
            self.selected_square = None
            self.refresh_board()

            if self.board.is_game_over():
                self.status_var.set('Partita conclusa. Prova un nuovo round e ripassa il piano tattico.')
                self.update_coach_message('Partita conclusa. Rivedi la posizione e rifletti su sviluppo, sicurezza del re e minacce tattiche.')
                return

            trainer_move = self.choose_trainer_move()
            if trainer_move is not None:
                self.board.push(trainer_move)
                self.status_var.set(f'Il trainer ha risposto con {trainer_move.uci()}. Continua a controllare il centro e i pezzi chiave.')
                self.update_coach_message(
                    f"Il trainer risponde con {trainer_move.uci()}.\n\n"
                    f"{self.trainer_feedback(trainer_move)}\n\n"
                    f"{self.level_guidance()}"
                )
            self.refresh_board()
            return

        self.selected_square = None
        self.refresh_board()

    def choose_trainer_move(self):
        legal_moves = list(self.board.legal_moves)
        if not legal_moves:
            return None

        preferred = {
            'beginner': ['e7e5', 'c7c5', 'g8f6', 'd7d5', 'f8c5', 'b8c6'],
            'intermediate': ['c7c5', 'g8f6', 'd7d6', 'g7g6', 'b8c6', 'e7e5'],
            'advanced': ['d7d5', 'c7c5', 'g8f6', 'c7c6', 'b8c6', 'f7f5']
        }

        for uci in preferred[self.level]:
            move = chess.Move.from_uci(uci)
            if move in legal_moves:
                return move

        return legal_moves[0]

    def trainer_feedback(self, trainer_move):
        move_name = trainer_move.uci()
        if self.level == 'beginner':
            return f"La risposta del trainer ({move_name}) punta a dare spazio alle figure e a creare un piano semplice: sviluppare, controllare il centro e non lasciare il re vulnerabile."
        if self.level == 'intermediate':
            return f"La risposta del trainer ({move_name}) fa parte di un piano più dinamico: equilibrio tra centro, sviluppo e idee tattiche. Guarda quali punti deboli stanno emergendo."
        return f"La risposta del trainer ({move_name}) mostra dinamica strategica: ha senso come idea e come piano. Vedi se c'è un tempo da sfruttare o un punto debole da colpire."

    def level_guidance(self):
        return f"{OPENING_GUIDE[self.level]} {TACTIC_GUIDE[self.level]}"

    def show_opening_help(self):
        self.status_var.set('Hai richiesto una spiegazione sulle aperture.')
        self.update_coach_message(f"Spiegazione apertura\n\n{OPENING_GUIDE[self.level]}\n\n{LESSONS[self.level][0]['coach']}")

    def show_tactic_help(self):
        self.status_var.set('Hai richiesto una spiegazione sulle tattiche.')
        self.update_coach_message(f"Spiegazione tattica\n\n{TACTIC_GUIDE[self.level]}\n\n{LESSONS[self.level][1]['coach']}")

    def refresh_board(self):
        for row in range(8):
            for col in range(8):
                btn = self.board_buttons[(row, col)]
                square = chess.square(col, 7 - row)
                piece = self.board.piece_at(square)
                light = (row + col) % 2 == 0
                btn.configure(bg='#f8fafc' if light else '#94a3b8', fg='#111827')
                btn.configure(text='')
                if piece is not None:
                    btn.configure(text=PIECE_SYMBOLS[piece.symbol()])
                if self.selected_square == square:
                    btn.configure(bg='#93c5fd')


def main():
    root = tk.Tk()
    ChessCoachTrainerApp(root)
    root.mainloop()


if __name__ == '__main__':
    main()
